+.acc-page{min-height:100vh;display:flex;flex-direction:column;background:var(--color-bg)}
+.acc-main{width:min(1000px,calc(100% - 48px));margin:0 auto;padding:32px 0 48px;flex:1}
+.acc-main h1{font-size:1.75rem;color:#153b2c;letter-spacing:-.4px}
+.acc-subtitle{margin-top:4px;color:var(--color-muted);font-size:.875rem}
+.acc-state{margin-top:32px;display:flex;flex-direction:column;align-items:flex-start;gap:var(--space-4);color:var(--color-muted)}
+.acc-layout{margin-top:24px;display:grid;grid-template-columns:280px minmax(0,1fr);gap:20px;align-items:start}
+.acc-forms{display:flex;flex-direction:column;gap:16px}
+.acc-card{background:var(--color-surface);border:1px solid #e4ece6;border-radius:var(--radius-lg);padding:24px}
+.acc-card h2{font-size:1.0625rem;color:#153b2c}
+.acc-card form{margin-top:16px;display:flex;flex-direction:column;gap:var(--space-4);align-items:flex-start}
+.acc-card form .alert{align-self:stretch}
+.acc-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4);width:100%}
+.acc-grid>*{min-width:0}
+.acc-grid__full{grid-column:1/-1}
+.acc-hint{margin-top:4px;font-size:.75rem;color:var(--color-muted)}
+.acc-profile{display:flex;flex-direction:column;align-items:flex-start;gap:8px}
+.acc-profile h2{margin-top:8px;font-size:1.125rem}
+.acc-avatar{width:72px;height:72px;border-radius:50%;background:#e8f4ec;color:var(--color-primary);display:grid;place-items:center;font-size:1.75rem;font-weight:800;overflow:hidden}
+.acc-avatar__img{width:100%;height:100%;object-fit:cover}
+.acc-muted{font-size:.8125rem;color:var(--color-muted)}
+.acc-roles{list-style:none;margin:4px 0 0;padding:0;display:flex;gap:8px;flex-wrap:wrap}
+.acc-roles li{background:var(--color-success-bg);color:var(--color-success);font-size:.75rem;font-weight:700;padding:3px 10px;border-radius:999px}
+.acc-nav{margin-top:12px;display:flex;flex-direction:column;gap:12px;font-size:.875rem}
+.acc-nav a{color:var(--color-muted);text-decoration:none}
+.acc-nav a:hover,.acc-nav a:first-child{color:var(--color-primary)}
+.acc-footer{border-top:1px solid #e1e9e3;background:#fff;padding:20px 24px;display:flex;align-items:center;gap:16px;color:#84948b}
+.acc-footer .logo{display:inline-flex;align-items:center;gap:9px;color:#137448;font-weight:800;font-size:15px}
+.acc-footer .logo__icon{width:26px;height:26px}
+.acc-footer small{font-size:.75rem}
+.acc-footer small:last-child{margin-left:auto}
+@media (max-width:760px){
+  .acc-main{width:calc(100% - 28px);padding:24px 0 36px}
+  .acc-layout{grid-template-columns:1fr}
+  .acc-grid{grid-template-columns:1fr}
+  .acc-footer{flex-wrap:wrap;padding:18px 14px}
+  .acc-footer small:last-child{margin-left:0}
+}
