+            return null;
+        }
+    }
+
+    /**
+     * Khách điền/sửa tài khoản nhận hoàn cọc cho đơn đã hủy. Chỉ sửa được khi khoản
+     * hoàn chưa chuyển (Pending) hoặc chuyển lỗi (Failed -> mở lại để chuyển lại).
+     */
+    async updateRefundAccount(
+        userId: number,
+        bookingId: number,
+        dto: UpdateRefundAccountDto,
+    ) {
+        return this.database.transaction(async (connection) => {
+            const [booking] = await this.exec<
+                { booking_id: number; customer_id: number; status: string }[]
+            >(
+                connection,
+                `SELECT booking_id, customer_id, status FROM bookings WHERE booking_id = ? FOR UPDATE`,
+                [bookingId],
+            );
+
+            // Người lạ không được biết đơn có tồn tại
+            if (!booking || Number(booking.customer_id) !== userId) {
+                throw new NotFoundException('Không tìm thấy đơn đặt sân');
+            }
+
+            const refunds = await this.exec<{ refund_id: number; status: string }[]>(
+                connection,
+                `
+                SELECT r.refund_id, r.status
+                FROM payment_refunds r
+                JOIN payments py ON py.payment_id = r.payment_id
+                JOIN invoices i ON i.invoice_id = py.invoice_id
+                WHERE i.booking_id = ?
+                ORDER BY r.refund_id ASC
+                FOR UPDATE
+                `,
+                [bookingId],
+            );
+
+            if (refunds.length === 0) {
+                throw new NotFoundException('Đơn này không có khoản hoàn cọc nào');
+            }
+
+            const open = refunds.filter(
+                (refund) => refund.status === 'Pending' || refund.status === 'Failed',
+            );
+
+            if (open.length === 0) {
+                throw new ConflictException(
+                    'Khoản hoàn đã được chuyển, không thể sửa thông tin nhận hoàn',
+                );
+            }
+
+            for (const refund of open) {
+                await connection.execute(
+                    `
+                    UPDATE payment_refunds
+                    SET bank_name = ?, bank_account_number = ?, bank_account_name = ?,
+                        status = 'Pending', failure_reason = NULL
+                    WHERE refund_id = ?
+                    `,
+                    [dto.bank_name, dto.bank_account_number, dto.bank_account_name, refund.refund_id],
+                );
+
+                await connection.execute(
+                    `
+                    INSERT INTO payment_refund_history (refund_id, old_status, new_status, note, changed_by)
+                    VALUES (?, ?, 'Pending', ?, ?)
+                    `,
+                    [
+                        refund.refund_id,
+                        refund.status,
+                        refund.status === 'Failed'
+                            ? 'Khách cập nhật tài khoản nhận hoàn, mở lại để chuyển lại'
+                            : 'Khách cập nhật tài khoản nhận hoàn',
+                        userId,
+                    ],
+                );
+            }
+
+            return {
+                message: 'Đã lưu thông tin nhận hoàn',
+                booking_id: bookingId,
+                updated_refunds: open.length,
+                bank_name: dto.bank_name,
+                bank_account_number: dto.bank_account_number,
+                bank_account_name: dto.bank_account_name,
+            };
+        });
+    }
